project_name       = "week3-platform"
environment        = "dev"
aws_region         = "us-east-2"
vpc_cidr            = "10.30.0.0/16"
public_subnet_cidr  = "10.30.1.0/24"
instance_type       = "t3.micro"
root_volume_size    = 20

# Replace with your own public IP in CIDR notation.
# Find it with: curl -4 https://checkip.amazonaws.com
ssh_allowed_cidr = "203.0.113.10/32"

# Set these through environment variables instead of committing private data:
# export TF_VAR_ssh_public_key="$(cat ~/.ssh/id_ed25519.pub)"
# private_key_path = "~/.ssh/id_ed25519"
